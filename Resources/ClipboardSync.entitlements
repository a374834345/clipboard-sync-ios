<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ============ 基础必需 ============ -->
    <key>get-task-allow</key>
    <true/>

    <!-- ============ 后台运行 ============ -->
    <key>com.apple.developer.background-modes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
        <string>remote-notification</string>
    </array>
    <key>com.apple.developer.task-identifiers</key>
    <array>
        <string>com.clipboardsync.refresh</string>
    </array>
    <key>com.apple.multitasking.unlimitedassertions</key>
    <true/>

    <!-- ============ TrollStore 平台应用标识 ============ -->
    <!-- platform-application: true 让系统把本 App 视为系统级 platform binary，
         这是 TrollStore 应用使用任何 com.apple.private.* 私有 entitlement 的前置条件，
         没有这条会被 AMFI 在进程启动时拒绝 (SIGKILL → 闪退) -->
    <key>platform-application</key>
    <true/>

    <!-- ============ 剪贴板访问：消除"允许粘贴"横幅（核心）============ -->
    <!-- iOS 17 SpringBoard 真正检查的 key：让本 App 视为系统级可信，
         读取任何 App 写入的剪贴板都不弹横幅 -->
    <key>com.apple.private.pasteboard.allow-automatic-access</key>
    <true/>
    <!-- 旧版兼容 -->
    <key>com.apple.pasteboard.read-automatic</key>
    <true/>
    <key>com.apple.pasteboard.allow-background-reading</key>
    <true/>
    <!-- TCC 数据库直接放行剪贴板权限 -->
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServicePasteboard</string>
    </array>
</dict>
</plist>
